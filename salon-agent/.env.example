# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection string. On Supabase: Project Settings -> Database -> Connection string
# -> "Transaction pooler" (port 6543). Locally: postgres://postgres@127.0.0.1:5432/salon_dev
DATABASE_URL=postgres://postgres:password@db.your-project.supabase.co:6543/postgres

# Separate database used by `npm test` (it is wiped on every run - never point it at production!)
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/salon_test

# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# Model the agent uses
ANTHROPIC_MODEL=claude-sonnet-5-5

# Which salon /api/chat serves when the request does not name one (slug from the salons table)
DEFAULT_SALON_SLUG=demo-barber
