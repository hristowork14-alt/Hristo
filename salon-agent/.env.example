# Copy to .env.local (local) and add the same names in Vercel -> Settings -> Environment Variables.
# Never commit .env.local.

# ── Database ──────────────────────────────────────────────────────────────
# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543)
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# A SEPARATE throwaway database for `npm test` (it is wiped on every run - never production!)
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/salon_test

# ── Claude ────────────────────────────────────────────────────────────────
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Salon ─────────────────────────────────────────────────────────────────
# Which salon /api/chat and the Telegram bot serve (slug from the salons table)
DEFAULT_SALON_SLUG=demo-barber
TELEGRAM_SALON_SLUG=demo-barber
# Used by `npm run db:seed`: the email that may log in to this salon's dashboard
OWNER_EMAIL=

# ── Owner login (Supabase Auth). Public values: they are sent to the browser. ──
# Supabase -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# ── Telegram (optional) ───────────────────────────────────────────────────
# Create a bot with @BotFather; it gives you the token.
TELEGRAM_BOT_TOKEN=
# Any long random string; Telegram sends it back so we know calls are genuine.
TELEGRAM_WEBHOOK_SECRET=

# ── Scheduled jobs (follow-ups + 24h reminders) ───────────────────────────
# Any long random string. Vercel Cron sends it automatically as "Authorization: Bearer ...".
CRON_SECRET=
